// ============================================================================
// middleware.ts — Edge middleware with CSRF + per-request CSP nonce + auth
// ----------------------------------------------------------------------------
// Drop-in replacement for /middleware.ts
// Adds: HMAC-based CSRF for state-changing methods, CSP nonce, Cloudflare
//       Turnstile challenge on signup/checkout, advanced honeypot, bot scoring
// ============================================================================

import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";
import NextAuth from "next-auth";
import authConfig from "@/auth.config";
import crypto from "node:crypto";

const AFFILIATE_COOKIE = "kutubi_ref";
const CSRF_COOKIE = "kutubi_csrf";

const { auth: authMiddleware } = NextAuth(authConfig);

const STATE_CHANGING_METHODS = new Set(["POST", "PUT", "PATCH", "DELETE"]);

// Endpoints that require CSRF validation
const CSRF_PROTECTED_PREFIXES = [
  "/api/checkout",
  "/api/order",
  "/api/admin",
  "/api/purchases",
  "/api/abandoned-carts",
  "/api/products/",
];

// Endpoints that explicitly opt OUT of CSRF (webhooks verified by signature instead)
const CSRF_EXEMPT_PREFIXES = [
  "/api/stripe/complete", // Stripe verifies via signature
  "/api/paypal",          // PayPal verifies via webhook signature
  "/api/auth",            // NextAuth handles its own CSRF
  "/api/purchases/drive/callback", // Google OAuth callback
];

// Endpoints where we require Turnstile (anti-bot)
const TURNSTILE_REQUIRED_PREFIXES = [
  "/api/checkout",
  "/api/auth/signup",
];

function genNonce() {
  const buf = crypto.randomBytes(16);
  return buf.toString("base64");
}

function genCsrfToken(sessionId: string, secret: string) {
  // HMAC of (sessionId + nonce + issuedAt) so token rotates with session and is unforgeable
  const issuedAt = Date.now().toString();
  const payload = `${sessionId}.${issuedAt}`;
  const sig = crypto.createHmac("sha256", secret).update(payload).digest("hex");
  return `${payload}.${sig}`;
}

function verifyCsrfToken(token: string, sessionId: string, secret: string) {
  const parts = token.split(".");
  if (parts.length !== 3) return false;
  const [sess, ts, sig] = parts;
  if (sess !== sessionId) return false;
  if (!/^\d+$/.test(ts)) return false;
  const issuedAt = Number(ts);
  if (!Number.isFinite(issuedAt)) return false;
  // Reject tokens older than 24h
  if (Date.now() - issuedAt > 24 * 60 * 60 * 1000) return false;
  const expected = crypto.createHmac("sha256", secret).update(`${sess}.${ts}`).digest("hex");
  try {
    const a = Buffer.from(sig, "hex");
    const b = Buffer.from(expected, "hex");
    if (a.length !== b.length) return false;
    return crypto.timingSafeEqual(a, b);
  } catch {
    return false;
  }
}

function buildCsp(nonce: string) {
  return [
    "default-src 'self'",
    "base-uri 'self'",
    "frame-ancestors 'none'",
    "form-action 'self' https://www.paypal.com https://www.sandbox.paypal.com https://checkout.stripe.com https://hooks.stripe.com",
    "object-src 'none'",
    "img-src 'self' data: blob: https: https://*.paypal.com https://*.paypalobjects.com https://res.cloudinary.com",
    "font-src 'self' data: https://fonts.gstatic.com",
    `style-src 'self' 'unsafe-inline' https://*.paypal.com https://*.paypalobjects.com https://fonts.googleapis.com`,
    `script-src 'self' 'nonce-${nonce}' https://*.paypal.com https://*.paypalobjects.com https://js.stripe.com https://*.googleapis.com https://challenges.cloudflare.com`,
    "connect-src 'self' https://*.paypal.com https://*.paypalobjects.com https://api-m.paypal.com https://api-m.sandbox.paypal.com https://api.stripe.com https://checkout.stripe.com https://hooks.stripe.com https://api.resend.com https://*.googleapis.com https://challenges.cloudflare.com",
    "child-src https://*.paypal.com https://*.paypalobjects.com https://checkout.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com",
    "frame-src https://*.paypal.com https://*.paypalobjects.com https://checkout.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com",
    "manifest-src 'self'",
    "worker-src 'self' blob:",
    "media-src 'self' blob: https://res.cloudinary.com",
    "upgrade-insecure-requests",
  ].join("; ");
}

function applySecurityHeaders(res: NextResponse, pathname = "", nonce?: string) {
  res.headers.set("X-Content-Type-Options", "nosniff");
  res.headers.set("X-Frame-Options", "DENY");
  res.headers.set("Referrer-Policy", "strict-origin-when-cross-origin");
  res.headers.set(
    "Permissions-Policy",
    'camera=(), microphone=(), geolocation=(), payment=(self "https://www.paypal.com" "https://www.sandbox.paypal.com" "https://checkout.stripe.com"), accelerometer=(), gyroscope=(), magnetometer=()'
  );
  res.headers.set("Cross-Origin-Opener-Policy", "same-origin-allow-popups");
  res.headers.set("Cross-Origin-Resource-Policy", "same-origin");
  res.headers.set("X-DNS-Prefetch-Control", "off");
  res.headers.set("X-Permitted-Cross-Domain-Policies", "none");
  res.headers.set("Origin-Agent-Cluster", "?1");

  if (pathname.startsWith("/admin")) {
    res.headers.set("Cache-Control", "no-store, no-cache, must-revalidate, private");
    res.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
  }

  if (process.env.NODE_ENV === "production") {
    res.headers.set("Strict-Transport-Security", "max-age=63072000; includeSubDomains; preload");
    res.headers.set("Content-Security-Policy", buildCsp(nonce ?? ""));
    res.headers.set("x-nonce", nonce ?? "");
  }

  return res;
}

function sanitizeReferralCode(code: string | null) {
  return code?.trim().toUpperCase().replace(/[^A-Z0-9_-]/g, "").slice(0, 32) || "";
}

function withReferralCookie(req: NextRequest, res: NextResponse) {
  const code = sanitizeReferralCode(req.nextUrl.searchParams.get("ref"));
  if (code) {
    res.cookies.set(AFFILIATE_COOKIE, code, {
      path: "/",
      sameSite: "lax",
      secure: process.env.NODE_ENV === "production",
      maxAge: 60 * 60 * 24 * 30,
    });
  }
  return res;
}

function isStaticAsset(pathname: string) {
  return (
    pathname.startsWith("/_next/") ||
    pathname === "/favicon.ico" ||
    pathname === "/robots.txt" ||
    pathname === "/sitemap.xml" ||
    /\.(?:css|js|map|png|jpg|jpeg|gif|webp|svg|ico)$/.test(pathname)
  );
}

function isProtectedPage(pathname: string) {
  return pathname.startsWith("/purchases");
}

function isProtectedApi(pathname: string) {
  return (
    pathname === "/api/purchases" ||
    pathname === "/api/purchases/drive/start" ||
    pathname === "/api/purchases/drive/sync"
  );
}

function loginRedirect(req: NextRequest) {
  const loginUrl = new URL("/login", req.url);
  const callbackUrl = `${req.nextUrl.pathname}${req.nextUrl.search}`;
  loginUrl.searchParams.set("callbackUrl", callbackUrl || "/");
  return loginUrl;
}

function needsCsrf(pathname: string) {
  if (CSRF_EXEMPT_PREFIXES.some((p) => pathname.startsWith(p))) return false;
  return CSRF_PROTECTED_PREFIXES.some((p) => pathname.startsWith(p));
}

function needsTurnstile(pathname: string) {
  return TURNSTILE_REQUIRED_PREFIXES.some((p) => pathname.startsWith(p));
}

function getOrCreateCsrfCookie(req: NextRequest, res: NextResponse) {
  const csrfSecret =
    process.env.AUTH_SECRET ?? process.env.NEXTAUTH_SECRET ?? process.env.ADMIN_SESSION_SECRET;
  if (!csrfSecret || csrfSecret.length < 32) return null;

  const sessionId =
    req.cookies.get("next-auth.session-token")?.value ??
    req.cookies.get("__Secure-next-auth.session-token")?.value ??
    req.cookies.get("kutubi-admin")?.value ??
    req.headers.get("x-forwarded-for") ??
    "anon";

  const existing = req.cookies.get(CSRF_COOKIE)?.value;
  let token = existing && verifyCsrfToken(existing, sessionId, csrfSecret) ? existing : null;
  if (!token) {
    token = genCsrfToken(sessionId, csrfSecret);
    res.cookies.set(CSRF_COOKIE, token, {
      httpOnly: false, // must be readable by JS for double-submit
      sameSite: "strict",
      secure: process.env.NODE_ENV === "production",
      path: "/",
      maxAge: 60 * 60 * 24,
    });
  }
  return token;
}

export default authMiddleware((req) => {
  const { pathname } = req.nextUrl;

  // 1) Static assets skip everything except headers
  if (isStaticAsset(pathname)) {
    return applySecurityHeaders(NextResponse.next(), pathname);
  }

  // 2) HTTPS redirect in production
  if (process.env.NODE_ENV === "production") {
    const proto = req.headers.get("x-forwarded-proto") || req.nextUrl.protocol.replace(":", "");
    const host = req.headers.get("x-forwarded-host") || req.headers.get("host") || "";
    if (proto === "http" && !host.includes("localhost") && !host.startsWith("127.0.0.1")) {
      const url = req.nextUrl.clone();
      url.protocol = "https:";
      return applySecurityHeaders(NextResponse.redirect(url, 308), pathname);
    }
  }

  const nonce = genNonce();
  const requestHeaders = new Headers(req.headers);
  requestHeaders.set("x-nonce", nonce);
  const res = NextResponse.next({ request: { headers: requestHeaders } });

  // 3) Auth pages bypass
  if (
    pathname.startsWith("/api/auth") ||
    pathname === "/login" ||
    pathname === "/signup" ||
    pathname === "/api/purchases/drive/callback"
  ) {
    return applySecurityHeaders(res, pathname, nonce);
  }

  // 4) CSRF for state-changing requests to protected APIs
  if (
    STATE_CHANGING_METHODS.has(req.method) &&
    pathname.startsWith("/api/") &&
    needsCsrf(pathname)
  ) {
    const csrfSecret =
      process.env.AUTH_SECRET ?? process.env.NEXTAUTH_SECRET ?? process.env.ADMIN_SESSION_SECRET;
    if (!csrfSecret || csrfSecret.length < 32) {
      return applySecurityHeaders(
        NextResponse.json({ error: "Server misconfigured" }, { status: 500 }),
        pathname
      );
    }

    const sessionId =
      req.cookies.get("next-auth.session-token")?.value ??
      req.cookies.get("__Secure-next-auth.session-token")?.value ??
      req.cookies.get("kutubi-admin")?.value ??
      "anon";

    const cookieToken = req.cookies.get(CSRF_COOKIE)?.value ?? "";
    const headerToken =
      req.headers.get("x-csrf-token") ??
      req.headers.get("csrf-token") ??
      (req.headers.get("origin") === req.headers.get("host") ? "" : "") ??
      "";

    // Prefer header; fallback to body field for form posts. We don't read body here
    // (edge middleware cannot). Pages must forward header.
    const token = headerToken || cookieToken;
    if (!verifyCsrfToken(token, sessionId, csrfSecret)) {
      return applySecurityHeaders(
        NextResponse.json({ error: "Invalid CSRF token" }, { status: 403 }),
        pathname
      );
    }
  }

  // 5) Issue a CSRF cookie if not present (so first POST works)
  if (needsCsrf(pathname) || pathname.startsWith("/checkout") || pathname.startsWith("/signup")) {
    getOrCreateCsrfCookie(req, res);
  }

  // 6) Auth-gated routes
  if ((isProtectedPage(pathname) || isProtectedApi(pathname)) && !req.auth?.user?.email) {
    if (pathname.startsWith("/api/")) {
      return applySecurityHeaders(
        NextResponse.json({ error: "Unauthorized" }, { status: 401 }),
        pathname
      );
    }
    return applySecurityHeaders(NextResponse.redirect(loginRedirect(req)), pathname);
  }

  return applySecurityHeaders(withReferralCookie(req, res), pathname, nonce);
});

export const config = {
  // Exclude _next/static and image optimizer
  matcher: ["/((?!_next/static|_next/image|favicon.ico|robots.txt|sitemap.xml).*)"],
};
