# ============================================================================
# .env.example — Complete environment template with all new services
# ----------------------------------------------------------------------------
# New file: /.env.example (replaces the current one)
# ============================================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Site ---
# Must match the exact public URL users open (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
AUTH_URL="https://your-domain.vercel.app"

# --- Google OAuth (customer login) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URIs:
# https://your-domain.vercel.app/api/auth/callback/google
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Admin (bcrypt only) ---
ADMIN_EMAIL="admin@your-domain.com"
# Initial password (>= 12 chars). Used ONLY for first-run bootstrap,
# then stored as bcrypt hash in AdminUser table.
ADMIN_BOOTSTRAP_PASSWORD=""
# Long random secret for admin cookie HMAC
ADMIN_SESSION_SECRET="generate-with-openssl-rand-base64-32"

# --- Email (Resend) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@your-domain.com"

# --- PayPal ---
PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CURRENCY="USD"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_CURRENCY="usd"
NEXT_PUBLIC_STRIPE_CURRENCY="USD"
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Google Drive linking (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# --- Sentry (optional) ---
SENTRY_DSN=""
SENTRY_ENV="production"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"

# --- Cloudflare Turnstile (anti-bot) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Cron secret (for Vercel Cron routes) ---
CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- Next-intl ---
NEXT_INTL_ENABLED="false"
DEFAULT_LOCALE="ar"
SUPPORTED_LOCALES="ar,en"

# --- Feature flags ---
FEATURE_ABANDONED_CART_REMINDERS="true"
FEATURE_UPSELL="true"
FEATURE_BUNDLES="true"
