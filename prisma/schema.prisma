generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  excerpt         String
  description     String
  price           Int
  compareAt       Int?
  badge           String
  grade           String
  subject         String
  category        String
  format          String
  pages           String
  level           String
  featured        Boolean      @default(false)
  status          String       @default("published")
  accentA         String       @default("#8a1538")
  accentB         String       @default("#5f1029")
  coverImage      String?
  additionalImages String[]     @default([])
  motionEnabled   Boolean      @default(false)
  motionPosition  String?
  motionScale     Float?       @default(1)
  motionRotation  Float?       @default(0)
  motionSrc       String?
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  files           ProductFile[]
  orderItems      OrderItem[]
  reviews         Review[]
  upsellProducts  String[]     @default([])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  email     String
  userName  String
  rating    Int
  comment   String?
  status    String   @default("approved")
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@index([email])
}

model AffiliateProfile {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  code         String   @unique
  commissionRate Float  @default(0.10) // 10%
  totalEarned  Int      @default(0)
  createdAt    DateTime @default(now())
}

model AbandonedCart {
  id           String   @id @default(cuid())
  email        String
  cartData     String   // JSON string of cart items
  notified     Boolean  @default(false)
  recovered    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model ProductFile {
  id         String   @id @default(cuid())
  productId  String
  title      String
  url        String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloadTokens DownloadToken[]
}

model ContentPage {
  id         String   @id @default(cuid())
  slug       String   @unique
  grade      String
  subject    String
  title      String
  intro      String
  body       String
  heroLabel  String   @default("صفحة مادة")
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Grade {
  id         String    @id @default(cuid())
  name       String    @unique
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  subjects   Subject[]
}

model Subject {
  id         String   @id @default(cuid())
  gradeId    String
  name       String
  motionLogo String?
  sortOrder  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, name])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}


model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                    String            @id @default(cuid())
  customerName          String
  email                 String
  phone                 String?
  notes                 String?
  total                 Int
  status                String            @default("pending")
  paymentMethod         String
  providerOrderId       String?           @unique
  providerCaptureId     String?
  purchaseTrackingConsent Boolean          @default(false)
  driveSyncConsent      Boolean           @default(false)
  voucherId             String?
  walletUsed            Int               @default(0)
  downloadClaimHash     String?
  downloadClaimExpiresAt DateTime?
  downloadClaimUsedAt   DateTime?
  downloadSessionHash   String?
  downloadSessionExpiresAt DateTime?
  downloadSessionUsedAt DateTime?
  createdAt             DateTime          @default(now())
  items                 OrderItem[]
  downloadTokens        DownloadToken[]

  @@index([email])
  @@index([status])
  @@index([purchaseTrackingConsent])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String?
  productId     String
  productTitle  String
  price         Int
  quantity      Int

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product Product  @relation(fields: [productId], references: [id])
}

model DownloadToken {
  id         String   @id @default(cuid())
  orderId    String
  fileId     String
  tokenHash  String   @unique
  expiresAt   DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file  ProductFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model PurchaseAccessToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model GoogleDriveConnection {
  id                    String    @id @default(cuid())
  email                 String    @unique
  refreshTokenEncrypted String
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastSyncedAt          DateTime?
}

model DriveFileSync {
  id          String   @id @default(cuid())
  email       String
  orderId     String
  fileId      String
  driveFileId String
  syncedAt    DateTime @default(now())

  @@unique([email, orderId, fileId])
  @@index([email])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model UserWallet {
  id           String   @id @default(cuid())
  email        String   @unique
  balance      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]

  @@index([email])
}

model GiftVoucher {
  id          String    @id @default(cuid())
  code        String    @unique
  amount      Int
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  usages VoucherUsage[]
}

model VoucherUsage {
  id         String   @id @default(cuid())
  voucherId  String
  email      String
  orderId    String?  @unique
  usedAt     DateTime @default(now())

  voucher GiftVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, email])
  @@index([email])
  @@index([voucherId])
  @@index([usedAt])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String
  amount      Int
  description String?
  orderId     String?
  createdAt   DateTime @default(now())

  wallet UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([orderId])
}

model WalletReservation {
  id        String   @id @default(cuid())
  email     String
  orderId   String   @unique
  amount    Int
  status    String   @default("reserved")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@index([status])
}

