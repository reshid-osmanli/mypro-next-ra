    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "cloudinary": "^2.10.0",
    "dotenv": "16.6.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.18",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "^17.7.0",
